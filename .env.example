# Copy to .env (gitignored) for `docker compose up`. The compose file fails fast if any
# of these is missing rather than starting with a blank secret.
JWT_KEY=
REFRESH_PEPPER=

# Web Push (Stream P). Optional: with these blank the app runs normally and simply
# reports push as unavailable, so the settings screen hides it and the notification
# jobs skip. Generate a pair with scripts/generate-vapid-keys.sh.
# Rotating them invalidates every existing subscription — browsers pin the key they
# subscribed with — so every device has to re-register by hand afterwards.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@expensetracker.local
