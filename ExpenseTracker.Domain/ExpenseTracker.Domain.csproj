<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sugg-11: the only package Domain genuinely needs. `User : IdentityUser`
         is an ASP.NET Identity type, and prying it apart would mean a new
         identity schema and migrations, not a mechanical move. This is the
         Identity *abstraction* package: unlike the EntityFrameworkCore one it
         was carrying before, it drags no EF, no JwtBearer and no DI container
         into the domain layer. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Entities\User\SeedConfiguration\" />
    <Folder Include="Enums\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseTracker.Shared\ExpenseTracker.Shared.csproj" />
  </ItemGroup>

</Project>
